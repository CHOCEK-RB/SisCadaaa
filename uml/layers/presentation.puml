class UserController <<Controller>> {
  - accessService: AccessApplicationService
  - profileService: ProfileApplicationService
 
 + POST /users/register(): HttpResponse
  + POST /users/login(): HttpResponse
  + POST /users/activate(): HttpResponse
  + GET /users/me/profile(): HttpResponse
  + PUT /users/me/profile(): HttpResponse
  + PUT /users/me/password(): HttpResponse
}

